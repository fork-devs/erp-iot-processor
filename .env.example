# ==============================================================================
# ERP IOT PROCESSOR SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# This file documents environment variable names and development defaults.
# Production secrets must be provided via vault / secure secret manager.
# ==============================================================================

# Server settings
ENVIRONMENT=dev
SERVER_PORT=8088
LOG_LEVEL=INFO

# Kafka Consumer settings
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=erp-iot-processor-group
KAFKA_TELEMETRY_TOPIC=telemetry.raw
KAFKA_DLQ_TOPIC=telemetry.dlq
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT_MS=500
KAFKA_AUTO_OFFSET_RESET=latest

# TimescaleDB (PostgreSQL) settings
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=erp_telemetry
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres
TIMESCALE_POOL_MIN=2
TIMESCALE_POOL_MAX=10

# MongoDB settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB=iot_diagnostics

# Security
JWT_SECRET_KEY=development-secret-key-32-bytes-min!!
